{
  "name": "denis-bunchenko-blog",
  "version": "0.1.0",
  "stardriveVersion": "1.4.4",
  "private": true,
  "description": "The personal website and trilingual blog of Denis Bunchenko",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "brand-assets": "node scripts/generateBrandAssets.js",
    "postbuild": "scripts/postbuild.js",
    "check": "npm run check:astro && npm run check:type && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:type": "tsc --noEmit",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "check:seo": "node scripts/checkSeo.js",
    "check:visual": "node scripts/captureResponsive.js",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "test": "npm run check && npm run build"
  },
  "keywords": [
    "astro",
    "blog",
    "personal-website",
    "i18n",
    "editorial-design"
  ],
  "author": {
    "name": "Denis Bunchenko",
    "url": "https://denisbunchenko.com/"
  },
  "license": "MIT",
  "type": "module",
  "homepage": "https://denisbunchenko.com/",
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "astro-expressive-code": "^0.44.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/ts-plugin": "^1.10.10",
    "@eslint/js": "^10.0.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@typescript-eslint/parser": "^8.65.0",
    "astro-compress": "^2.4.1",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-security": "^4.0.1",
    "fs-extra": "^11.4.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
