---
import '@styles/global.css';
import '@styles/blog.css';
import Footer from '@components/layout/footer.astro';
import Header from '@components/layout/header.astro';
import HeadBase from '@components/head/base.astro';
import HeadHrefLang from '@components/head/hreflang.astro';
import HeadOgX from '@components/head/ogx.astro';
import ArticleStructuredData from '@components/structured/article.astro';
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getCleanLocaleUrl, getLocaleUrl, useTranslations } from '@utils/i18n';
import { resolveArticleAuthor } from '@utils/article-author';
import { themeConfig } from '~/theme.config';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  isError?: boolean;
  imgUrl?: string;
  xImgUrl?: string;
  imageAlt?: string;
  locale?: string;
  noi18n?: boolean;
}

const locale = Astro.props.locale || themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
const title = Astro.props.title || t('meta.title');
const description = Astro.props.description || t('meta.description');
const { imgUrl, xImgUrl, imageAlt, isError, noi18n, robots } = Astro.props;
const articleEntry = (await getEntry('articles', `${locale}/${String(Astro.params.article)}`)) as CollectionEntry<'articles'>;
const imageUrl = imgUrl ? new URL(imgUrl, Astro.site).href : undefined;
const xImageUrl = xImgUrl ? new URL(xImgUrl, Astro.site).href : undefined;
const structuredImageUrls = [imageUrl ?? new URL('/images/og.png', Astro.site).href, xImageUrl ?? new URL('/images/x.png', Astro.site).href];
const authorUrl = resolveArticleAuthor(articleEntry.data.author, themeConfig.articles?.defaults?.author)?.url;
const canonicalUrl = articleEntry.data.externalCanonical || getCleanLocaleUrl(Astro.url, locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <HeadBase {title} {description} {locale} {robots} {isError} externalCanonical={articleEntry.data.externalCanonical} />
    <HeadHrefLang {locale} {noi18n} collection="articles" contentId={articleEntry.id} />
    <HeadOgX
      {locale}
      {title}
      {description}
      type="article"
      url={canonicalUrl}
      ogTitle={themeConfig.ogTitle || t('meta.og-site-name')}
      ogImage={imageUrl}
      xImage={xImageUrl || imageUrl}
      imageAlt={imageAlt || t('meta.social-image-alt')}
      publishDate={articleEntry.data.publishDate}
      updateDate={articleEntry.data.updateDate}
      {authorUrl}
      section={articleEntry.data.categories?.[0]}
      tags={articleEntry.data.tags}
    />
    <ArticleStructuredData {title} {description} {articleEntry} {locale} imageUrls={structuredImageUrls} />
  </head>
  <body>
    <div class="site-page">
      <Header {locale} button={{ text: t('labels.back-all-articles'), href: getLocaleUrl('blog', locale) }} {noi18n} collection="articles" contentId={articleEntry.id} />
      <main id="main-content"><div class="site-shell"><slot /></div></main>
      <Footer {locale} />
    </div>
  </body>
</html>
