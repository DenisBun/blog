---
import '@styles/global.css';
import Footer from '@components/layout/footer.astro';
import Header from '@components/layout/header.astro';
import HeadBase from '@components/head/base.astro';
import HeadHrefLang from '@components/head/hreflang.astro';
import HeadOgX from '@components/head/ogx.astro';
import WebsiteStructuredData from '@components/structured/website.astro';
import WebPageStructuredData from '@components/structured/webpage.astro';
import { themeConfig } from '~/theme.config';
import { useTranslations } from '@utils/i18n';
import type { CollectionKey } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  header?: {
    hidden?: boolean;
    button?: { text: string; href: string };
    closeIcon?: boolean;
  };
  robots?: string;
  isError?: boolean;
  locale?: string;
  noi18n?: boolean;
  isHome?: boolean;
  noTitleSlug?: boolean;
  schemaType?: 'WebPage' | 'ProfilePage' | 'CollectionPage';
  collection?: CollectionKey;
  contentId?: string;
  noContainer?: boolean;
}

const locale = Astro.props.locale || themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
const title = Astro.props.title || t('meta.title');
const description = Astro.props.description || t('meta.description');
const { header, isError, noi18n, noTitleSlug, robots, isHome, collection, contentId, noContainer, schemaType = 'WebPage' } = Astro.props;
const metaTitle = noTitleSlug ? title : `${title} | ${t('meta.slug')}`;
const personId = `${new URL('/', Astro.site).href}#person`;
const author = {
  '@id': personId,
  '@type': themeConfig.author.type,
  name: themeConfig.author.name,
  url: themeConfig.author.url,
  image: themeConfig.author.image ? new URL(themeConfig.author.image, Astro.site).href : undefined,
};
const publisher = {
  '@id': personId,
  '@type': themeConfig.publisher.type,
  name: themeConfig.publisher.name,
  url: themeConfig.publisher.url,
  image: themeConfig.publisher.image ? new URL(themeConfig.publisher.image, Astro.site).href : undefined,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <HeadBase title={metaTitle} {description} {locale} {robots} {isError} />
    {!isError && <HeadHrefLang {locale} {noi18n} {collection} {contentId} />}
    {!isError && <HeadOgX {locale} title={metaTitle} {description} imageAlt={t('meta.social-image-alt')} ogTitle={themeConfig.ogTitle || t('meta.og-site-name')} />}
    {isHome && locale === themeConfig.i18n.defaultLocale && <WebsiteStructuredData {description} image="/images/structured-preview.png" {author} {publisher} />}
    {!isError && <WebPageStructuredData type={schemaType} {title} {description} image="/images/structured-preview.png" {author} {publisher} {locale} mainEntity={schemaType === 'ProfilePage' ? author : undefined} />}
  </head>
  <body>
    <div class="site-page">
      {header?.hidden !== true && <Header {locale} button={header?.button} isHome={isHome} {noi18n} {collection} {contentId} />}
      <main id="main-content">
        {
          noContainer ? (
            <slot />
          ) : (
            <div class="site-shell">
              <slot />
            </div>
          )
        }
      </main>
      <Footer {noi18n} {collection} {contentId} {locale} />
    </div>
  </body>
</html>
