---
import Layout from '@layouts/default.astro';
import NotFound from '@components/error/not-found.astro';
import { useTranslations } from '@utils/i18n';
import { themeConfig } from '~/theme.config';

export function getStaticPaths() {
  return themeConfig.i18n.locales
    .filter((lang) => lang !== themeConfig.i18n.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang;
const t = useTranslations(locale);
---

<Layout title={t('pages.404.title')} description={t('pages.404.message')} isError {locale}>
  <NotFound {locale} />
</Layout>
