---
import Layout from '@layouts/default.astro';
import NotFound from '@components/error/not-found.astro';
import { useTranslations } from '@utils/i18n';
import { themeConfig } from '~/theme.config';

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
---

<Layout title={t('pages.404.title')} description={t('pages.404.message')} isError {locale}>
  <NotFound {locale} />
</Layout>
