---
import Layout from '@layouts/default.astro';
import AboutContent from '@components/about/about-content.astro';
import { useTranslations } from '@utils/i18n';
import { themeConfig } from '~/theme.config';

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
---

<Layout {locale} title={t('pages.about.title')} description={t('pages.about.description')} schemaType="ProfilePage">
  <AboutContent {locale} />
</Layout>
