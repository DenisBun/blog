---
import { getLocaleUrl, useTranslations } from '@utils/i18n';
import { themeConfig } from '~/theme.config';

interface Props {
  locale: string;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);
---

<footer class="site-footer">
  <div class="site-footer-inner site-shell">
    <span class="footer-signature">© {new Date().getFullYear()} {themeConfig.author.name}</span>
    <div class="footer-links">
      <a href={getLocaleUrl('rss.xml', locale)}>{t('labels.rss')}</a>
      <span class="footer-credit">Astro · Netlify</span>
    </div>
  </div>
</footer>
