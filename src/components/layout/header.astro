---
import type { CollectionKey } from 'astro:content';
import LanguageSelect from '@components/layout/language-select.astro';
import { getLocaleUrl, useTranslations } from '@utils/i18n';

interface Props {
  locale: string;
  button?: { text: string; href: string };
  isHome?: boolean;
  noi18n?: boolean;
  collection?: CollectionKey;
  contentId?: string;
}

const { locale, button, isHome, noi18n, collection, contentId } = Astro.props as Props;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [
  { href: getLocaleUrl('/', locale), label: t('labels.home') },
  { href: getLocaleUrl('about', locale), label: t('labels.about') },
  { href: getLocaleUrl('blog', locale), label: t('labels.blog') },
];
---

<header class="site-header" role="banner">
  <a class="skip-link" href="#main-content">{t('labels.skip-content')}</a>
  <div class="site-header-inner site-shell">
    <a href={getLocaleUrl('/', locale)} class="site-title" aria-current={isHome ? 'page' : undefined}> Denis Bunchenko </a>
    <div class="site-navigation">
      {
        button && (
          <nav class="back-navigation" aria-label={t('labels.back-navigation')}>
            <a href={button.href}>← {button.text}</a>
          </nav>
        )
      }
      <nav class="primary-navigation" aria-label={t('labels.primary-navigation')}>
        {
          items.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <LanguageSelect variant="header" {noi18n} {collection} {contentId} {locale} />
    </div>
  </div>
</header>
