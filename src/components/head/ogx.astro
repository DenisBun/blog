---
import { getCleanLocaleUrl } from "@utils/i18n";
import { themeConfig } from '~/theme.config';

interface Props {
  locale: string;
  title: string;
  ogTitle: string;
  description: string;
  ogImage?: string;
  xImage?: string;
  imageAlt?: string;
  url?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  updateDate?: Date;
  authorUrl?: string;
  section?: string;
  tags?: string[];
}

const { locale, title, description, ogTitle, ogImage, xImage, imageAlt = title, url: canonicalUrl, type = 'website', publishDate, updateDate, authorUrl, section, tags = [] } = Astro.props as Props;

const ogImg = ogImage ?? new URL('/images/og.png', Astro.site).href;
const xImg = xImage ?? new URL('/images/x.png', Astro.site).href;
const isDefaultOgImage = !ogImage;
const isDefaultXImage = !xImage;

function getOpenGraphLocale(code: string) {
  const expanded = new Intl.Locale(code).maximize();
  return expanded.region ? `${expanded.language}_${expanded.region}` : expanded.language;
}

function getImageMimeType(src: string) {
  const extension = new URL(src).pathname.split('.').pop()?.toLowerCase();
  if (extension === 'jpg' || extension === 'jpeg') return 'image/jpeg';
  if (extension === 'png') return 'image/png';
  if (extension === 'webp') return 'image/webp';
  return undefined;
}

const url = canonicalUrl ?? getCleanLocaleUrl(Astro.url, locale);
const ogLocale = getOpenGraphLocale(locale);
const alternateLocales = themeConfig.i18n.locales.filter((code) => code !== locale).map(getOpenGraphLocale);
const ogImageType = getImageMimeType(ogImg);
---

<!-- open graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImg} />
{ogImageType && <meta property="og:image:type" content={ogImageType} />}
{isDefaultOgImage && <meta property="og:image:width" content="1200" />}
{isDefaultOgImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:url" content={url} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={ogTitle} />
<meta property="og:locale" content={ogLocale} />
{alternateLocales.map((alternateLocale) => <meta property="og:locale:alternate" content={alternateLocale} />)}
{type === 'article' && publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
{type === 'article' && <meta property="article:modified_time" content={(updateDate ?? publishDate)?.toISOString()} />}
{type === 'article' && authorUrl && <meta property="article:author" content={authorUrl} />}
{type === 'article' && section && <meta property="article:section" content={section} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
<!-- x/twitter -->
<meta name="twitter:card" content="summary_large_image" />
{themeConfig.xHandle && themeConfig.xHandle !== '' ? <meta name="twitter:site" content={`@${themeConfig.xHandle}`} /> : ''}
{themeConfig.xHandle && themeConfig.xHandle !== '' ? <meta name="twitter:creator" content={`@${themeConfig.xHandle}`} /> : ''}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={xImg} />
<meta name="twitter:image:alt" content={imageAlt} />
{isDefaultXImage && <meta name="twitter:image:width" content="1600" />}
{isDefaultXImage && <meta name="twitter:image:height" content="900" />}
