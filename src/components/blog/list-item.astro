---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FallbackImage from '@images/content/articles-fallback.jpg';
import { getLocaleUrl, useTranslations } from '@utils/i18n';
import { getReadingTime } from '@utils/reading-time';
import { themeConfig } from '~/theme.config';

interface Props {
  entry: CollectionEntry<'articles'>;
  locale: string;
  wide?: boolean;
  noTransition?: boolean;
}

const { entry, locale, wide } = Astro.props as Props;
const t = useTranslations(locale);
const slug = entry.id.split('/').at(-1);
const imageFile = entry.data.image?.file || (!entry.data.image?.url && themeConfig.articles?.imageFallback ? FallbackImage : undefined);
const date = entry.data.publishDate.toLocaleDateString(locale, { dateStyle: 'medium' });
const monthYear = entry.data.publishDate.toLocaleDateString(locale, { month: 'short', year: 'numeric' });
---

<article class:list={['post-entry', wide && 'post-entry-featured']}>
  {
    wide && (
      <a class="post-entry-image" href={getLocaleUrl(`blog/${slug}`, locale)} tabindex="-1" aria-hidden="true">
        {imageFile ? <Image src={imageFile} alt="" widths={[320, 640, 960]} sizes="(min-width: 768px) 42vw, 100vw" /> : entry.data.image?.url ? <Image src={entry.data.image.url} alt="" inferSize /> : null}
      </a>
    )
  }
  {!wide && <time datetime={entry.data.publishDate.toISOString()}>{monthYear}</time>}
  <div class="post-entry-copy">
    <div class="post-entry-meta">
      {wide && <time datetime={entry.data.publishDate.toISOString()}>{date}</time>}
      {entry.data.categories?.[0] && <span>{t(`categories-t.${entry.data.categories[0]}`)}</span>}
      {entry.data.featured && <span>{t('labels.featured')}</span>}
    </div>
    <h2><a href={getLocaleUrl(`blog/${slug}`, locale)}>{entry.data.title}</a></h2>
    {entry.data.excerpt && <p>{entry.data.excerpt}</p>}
    {
      wide && (
        <span class="reading-time">
          {getReadingTime(entry.body)} {t('labels.min-read')}
        </span>
      )
    }
  </div>
  {
    !wide && (
      <a class="post-entry-arrow" href={getLocaleUrl(`blog/${slug}`, locale)} tabindex="-1" aria-hidden="true">
        →
      </a>
    )
  }
</article>
