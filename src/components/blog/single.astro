---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import CatTagList from '@components/blog/cat-tag-list.astro';
import ListItem from '@components/blog/list-item.astro';
import SocialShare from '@components/blog/social-share.astro';
import TableOfContents from '@components/blog/table-of-contents.astro';
import { getCleanLocaleUrl, useTranslations } from '@utils/i18n';
import { getReadingTime } from '@utils/reading-time';
import { themeConfig } from '~/theme.config';

interface Props {
  entry: CollectionEntry<'articles'>;
  prev?: CollectionEntry<'articles'>;
  next?: CollectionEntry<'articles'>;
  locale: string;
  imageFile?: ImageMetadata;
}

const { entry, locale, prev, next, imageFile } = Astro.props as Props;
const t = useTranslations(locale);
const { Content, headings } = await render(entry);
const tocDepth = entry.data.tocDepth ?? themeConfig.articles?.tocMaxDepth ?? 3;
const reducedHeadings = headings.filter(({ depth }) => depth <= tocDepth);
const articleUrl = getCleanLocaleUrl(Astro.url, locale);
const authorName = themeConfig.articles?.defaults?.author?.name || entry.data.author?.name;
const authorUrl = themeConfig.articles?.defaults?.author?.url || entry.data.author?.url;
const published = entry.data.publishDate.toLocaleDateString(locale, { dateStyle: 'long' });
const updated = entry.data.updateDate?.toLocaleDateString(locale, { dateStyle: 'long' });
---

<article id="start" class="article-layout">
  <header class="window article-header">
    <div class="window-titlebar">
      <span class="window-title">{entry.id.split('/').at(-1)}.txt</span>
      <span class="window-controls" aria-hidden="true"><span>_</span><span>□</span><span>×</span></span>
    </div>
    {imageFile ? <Image id="title-image" src={imageFile} alt={entry.data.image?.alt || ''} widths={[640, 960, 1440]} sizes="(min-width: 976px) 900px, 100vw" priority /> : entry.data.image?.url ? <Image id="title-image" src={entry.data.image.url} alt={entry.data.image.alt || ''} inferSize priority /> : null}
    <div class="article-heading">
      <p class="eyebrow">C:\DENIS\BLOG</p>
      <h1>{entry.data.title}</h1>
      {entry.data.excerpt && <p class="lead">{entry.data.excerpt}</p>}
    </div>
    <div class="status-bar article-meta">
      {
        authorName && (
          <span>
            {t('labels.author')}:{' '}
            {authorUrl ? (
              <a href={authorUrl} rel="author">
                {authorName}
              </a>
            ) : (
              authorName
            )}
          </span>
        )
      }
      <span>{t('labels.published')}: <time datetime={entry.data.publishDate.toISOString()}>{published}</time></span>
      {
        updated && (
          <span>
            {t('labels.updated')}: {updated}
          </span>
        )
      }
      <span>{getReadingTime(entry.body)} {t('labels.min-read')}</span>
    </div>
  </header>

  {
    reducedHeadings.length > 0 && (
      <details class="window toc-mobile">
        <>
          <summary class="win-button">{t('labels.toc')}</summary>
          <TableOfContents headings={reducedHeadings} {locale} />
        </>
      </details>
    )
  }

  <div class="article-columns">
    <div class="window article-body">
      <div class="window-titlebar"><span class="window-title">document</span></div>
      <div class="window-content markdown-content"><Content /></div>
      <div class="article-taxonomy">
        <CatTagList entries={entry.data.categories} {locale} type="categories" small />
        <CatTagList entries={entry.data.tags} {locale} type="tags" small />
      </div>
    </div>
    {
      reducedHeadings.length > 0 && (
        <aside class="window toc-desktop">
          <>
            <div class="window-titlebar">
              <span class="window-title">{t('labels.toc')}</span>
            </div>
            <TableOfContents headings={reducedHeadings} {locale} />
          </>
        </aside>
      )
    }
  </div>

  <section class="window share-window">
    <div class="window-titlebar"><span class="window-title">share.exe</span></div>
    <div class="window-content"><h2>{t('labels.share-article')}</h2><SocialShare url={articleUrl} title={entry.data.title} emailSubject={t('labels.share-email-subject')} {locale} /></div>
  </section>

  {
    (prev || next) && (
      <section class="related-posts">
        <>
          <h2>{t('labels.continue-reading')}</h2>
          <div class="post-grid">
            {prev && <ListItem entry={prev} {locale} noTransition />}
            {next && <ListItem entry={next} {locale} noTransition />}
          </div>
        </>
      </section>
    )
  }
</article>
