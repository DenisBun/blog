---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import CatTagList from '@components/blog/cat-tag-list.astro';
import ListItem from '@components/blog/list-item.astro';
import SocialShare from '@components/blog/social-share.astro';
import TableOfContents from '@components/blog/table-of-contents.astro';
import { getCleanLocaleUrl, useTranslations } from '@utils/i18n';
import { getReadingTime } from '@utils/reading-time';
import { themeConfig } from '~/theme.config';

interface Props {
  entry: CollectionEntry<'articles'>;
  prev?: CollectionEntry<'articles'>;
  next?: CollectionEntry<'articles'>;
  locale: string;
  imageFile?: ImageMetadata;
}

const { entry, locale, prev, next, imageFile } = Astro.props as Props;
const t = useTranslations(locale);
const { Content, headings } = await render(entry);
const tocDepth = entry.data.tocDepth ?? themeConfig.articles?.tocMaxDepth ?? 3;
const reducedHeadings = headings.filter(({ depth }) => depth <= tocDepth);
const articleUrl = getCleanLocaleUrl(Astro.url, locale);
const authorName = themeConfig.articles?.defaults?.author?.name || entry.data.author?.name;
const authorUrl = themeConfig.articles?.defaults?.author?.url || entry.data.author?.url;
const published = entry.data.publishDate.toLocaleDateString(locale, { dateStyle: 'long' });
const updated = entry.data.updateDate?.toLocaleDateString(locale, { dateStyle: 'long' });
---

<article id="start" class="article-layout">
  <header class="article-header">
    <p class="eyebrow">{entry.data.categories?.[0] || t('labels.blog')}</p>
    <div class="article-heading">
      <h1>{entry.data.title}</h1>
      {entry.data.excerpt && <p class="lead">{entry.data.excerpt}</p>}
    </div>
    <div class="article-meta">
      {
        authorName && (
          <span>
            {t('labels.author')}{' '}
            {authorUrl ? (
              <a href={authorUrl} rel="author">
                {authorName}
              </a>
            ) : (
              authorName
            )}
          </span>
        )
      }
      <span><time datetime={entry.data.publishDate.toISOString()}>{published}</time></span>
      {
        updated && (
          <span>
            {t('labels.updated')}: <time datetime={entry.data.updateDate?.toISOString()}>{updated}</time>
          </span>
        )
      }
      <span>{getReadingTime(entry.body)} {t('labels.min-read')}</span>
    </div>
  </header>

  {
    imageFile ? (
      <figure class="article-cover">
        <Image src={imageFile} alt={entry.data.image?.alt || ''} widths={[640, 960, 1440]} sizes="(min-width: 976px) 900px, 100vw" priority />
      </figure>
    ) : entry.data.image?.url ? (
      <figure class="article-cover">
        <Image src={entry.data.image.url} alt={entry.data.image.alt || ''} inferSize priority />
      </figure>
    ) : null
  }

  {
    reducedHeadings.length > 0 && (
      <details class="toc-mobile">
        <>
          <summary>{t('labels.toc')}</summary>
          <TableOfContents headings={reducedHeadings} {locale} />
        </>
      </details>
    )
  }

  <div class="article-columns">
    <div class="article-body">
      <div class="markdown-content"><Content /></div>
      <div class="article-taxonomy">
        <CatTagList entries={entry.data.categories} {locale} type="categories" small />
        <CatTagList entries={entry.data.tags} {locale} type="tags" small />
      </div>
    </div>
    {
      reducedHeadings.length > 0 && (
        <aside class="toc-desktop">
          <h2>{t('labels.toc')}</h2>
          <TableOfContents headings={reducedHeadings} {locale} />
        </aside>
      )
    }
  </div>

  <section class="share-section editorial-section">
    <header class="section-heading"><h2>{t('labels.share-article')}</h2></header>
    <SocialShare url={articleUrl} title={entry.data.title} emailSubject={t('labels.share-email-subject')} {locale} />
  </section>

  {
    (prev || next) && (
      <section class="related-posts editorial-section">
        <header class="section-heading">
          <h2>{t('labels.continue-reading')}</h2>
        </header>
        <div class="post-feed">
          {prev && <ListItem entry={prev} {locale} noTransition />}
          {next && <ListItem entry={next} {locale} noTransition />}
        </div>
      </section>
    )
  }
</article>
