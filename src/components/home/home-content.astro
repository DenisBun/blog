---
import { getLocaleUrl, useTranslations } from '@utils/i18n';
import AskAi from '@components/ai/ask-ai.astro';
import List from '@components/blog/list.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { sortArticleList } from '@utils/blog';

const { locale } = Astro.props;
const t = useTranslations(locale);
const recentArticles = sortArticleList(
  (await getCollection('articles', ({ id, data }) => !data.draft && id.startsWith(`${locale}/`))) as CollectionEntry<'articles'>[],
).slice(0, 4);
---

<div class="home-page">
  <header class="page-intro" aria-labelledby="home-title">
    <p class="eyebrow">{t('meta.slogan')}</p>
    <div class="page-intro-heading">
      <h1 id="home-title">{t('pages.home.hero-title')}</h1>
      <p class="lead">{t('pages.home.hero-sub-slogan')}</p>
    </div>
    <div class="page-intro-copy">
      <p>{t('pages.home.intro')}</p>
      <p>{t('pages.home.body')}</p>
      <p class="text-links">
        <a href={getLocaleUrl('blog', locale)}>{t('pages.home.blog-cta')} →</a>
        <a href={getLocaleUrl('about', locale)}>{t('pages.home.about-cta')} →</a>
      </p>
    </div>
  </header>

  {
    recentArticles.length > 0 && (
      <section class="editorial-section" aria-labelledby="recent-articles-title">
        <header class="section-heading">
          <h2 id="recent-articles-title">{t('pages.home.recent-articles')}</h2>
          <a href={getLocaleUrl('blog', locale)}>{t('pages.home.view-all')} →</a>
        </header>
        <List entries={recentArticles} {locale} firstBig />
      </section>
    )
  }

  <AskAi {locale} />
</div>
