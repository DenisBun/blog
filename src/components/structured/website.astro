---
import { toSafeJsonScript } from "@utils/security";
import { themeConfig } from '~/theme.config';

interface Props {
  description?: string;
  image?: string;
  author?: {
    "@id"?: string;
    "@type": "Person" | "Organization";
    name: string;
    url?: string;
    image?: string;
  }
  publisher?: {
    "@id"?: string;
    "@type": "Person" | "Organization";
    name: string;
    url?: string;
    image?: string;
  }
}

const { description, image } = Astro.props as Props;

const pageUrl = new URL('/', Astro.site).href;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;

const author = Astro.props.author ?? null;
const creator = author;
const publisher = Astro.props.publisher ?? null;

const structuredData = {
  "@context": "https://schema.org",
  "@id": `${themeConfig.site}/#website`,
  "@type": "WebSite",
  name: themeConfig.name,
  ...(description && { description }),
  url: pageUrl,
  inLanguage: themeConfig.i18n.locales,
  ...(imageUrl && { image: imageUrl }),
  author,
  creator,
  publisher,
}
---

<script is:inline type="application/ld+json" set:html={toSafeJsonScript(structuredData)} />
