---
import { getCleanLocaleUrl } from "@utils/i18n";
import { toSafeJsonScript } from "@utils/security";
import { themeConfig } from '~/theme.config';

interface Props {
  type: "WebPage" | "ProfilePage" | "CollectionPage";
  title: string;
  description?: string;
  image?: string;
  locale?: string;
  author?: {
    "@id"?: string;
    "@type": "Person" | "Organization";
    name: string;
    url?: string;
    image?: string;
  }
  publisher?: {
    "@id"?: string;
    "@type": "Person" | "Organization";
    name: string;
    url?: string;
    image?: string;
  }
  mainEntity?: {
    "@id"?: string;
    "@type": "Person" | "Organization";
    name: string;
    url?: string;
    image?: string;
  };
}

const { title, description, type, image, locale, mainEntity } = Astro.props as Props;

const pageUrl = getCleanLocaleUrl(Astro.url, locale);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;

const author = Astro.props.author ?? null;
const creator = author;
const publisher = Astro.props.publisher ?? null;

const structuredData = {
  "@context": "https://schema.org",
  "@id": `${pageUrl}#${type.toLowerCase()}`,
  "@type": type,
  name: title,
  ...(description && { description }),
  url: pageUrl,
  inLanguage: locale,
  ...(imageUrl && { primaryImageOfPage: { "@type": "ImageObject", url: imageUrl } }),
  author,
  creator,
  publisher,
  isPartOf: {
    "@id":`${themeConfig.site}/#website`
  },
  ...(mainEntity && { mainEntity }),
  "potentialAction": [
    {
      "@type": "ReadAction",
      "target": [`${pageUrl}`]
    }
  ]
}
---

<script is:inline type="application/ld+json" set:html={toSafeJsonScript(structuredData)} />
