---
import type { CollectionEntry } from "astro:content";
import { themeConfig } from '~/theme.config';
import { getCleanLocaleUrl, useTranslations } from '@utils/i18n';
import { toSafeJsonScript } from "@utils/security";
import { resolveArticleAuthor } from '@utils/article-author';

interface Props {
  title: string;
  description: string;
  articleEntry: CollectionEntry<'articles'>;
  locale?: string;
  imageUrls?: string[];
}

const { title, description, articleEntry, locale, imageUrls = [] } = Astro.props as Props;
const t = useTranslations(locale);

// Destructure articleEntry to get needed fields
const { publishDate, updateDate, author, categories = [], tags = [], externalCanonical } = articleEntry.data;

const { name: authorName, url: authorUrl } = resolveArticleAuthor(author, themeConfig.articles?.defaults?.author) ?? {};

const pageUrl = externalCanonical || getCleanLocaleUrl(Astro.url, locale);
const normalizedImages = [...new Set(imageUrls.map((imageUrl) => new URL(imageUrl, Astro.site).href))];
const homeUrl = new URL('/', Astro.site).href;
const blogUrl = new URL(locale === themeConfig.i18n.defaultLocale ? '/blog' : `/${locale}/blog`, Astro.site).href;
const authorId = author ? (authorUrl ? `${authorUrl.replace(/\/$/, '')}#person` : `${pageUrl}#author`) : `${homeUrl}#person`;

const structuredData = {
  "@context": "https://schema.org",
  "@id": `${pageUrl}#article`,
  "@type": "BlogPosting",
  headline: title,
  description: description,
  datePublished: publishDate.toISOString(),
  dateModified: (updateDate ?? publishDate).toISOString(),
  url: pageUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  inLanguage: locale,
  ...(normalizedImages.length > 0 && { image: normalizedImages, thumbnailUrl: normalizedImages[0] }),
  ...(categories[0] && { articleSection: categories[0] }),
  ...(tags.length > 0 && { keywords: tags }),
  author: {
    "@id": authorId,
    "@type": "Person",
    name: authorName ?? '',
    ...(authorUrl && { url: authorUrl }),
  },
  isPartOf: {
    "@id":`${themeConfig.site}/#website`
  },
  publisher: {
    "@id": `${new URL('/', Astro.site).href}#person`,
    "@type": themeConfig.publisher.type,
    name: themeConfig.publisher.name,
    url: themeConfig.publisher.url ?? Astro.site,
    ...(themeConfig.publisher.image && { image: new URL(themeConfig.publisher.image, Astro.site).href }),
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: themeConfig.name, item: homeUrl },
      { "@type": "ListItem", position: 2, name: t('labels.blog'), item: blogUrl },
      { "@type": "ListItem", position: 3, name: title, item: pageUrl },
    ],
  },
  "potentialAction": [
    {
      "@type": "ReadAction",
      "target": [`${pageUrl}`]
    }
  ]
}
---

<script is:inline type="application/ld+json" set:html={toSafeJsonScript(structuredData)} />
