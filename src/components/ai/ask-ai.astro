---
import { useTranslations } from '@utils/i18n';
import { themeConfig } from '~/theme.config';

interface Props {
  locale: string;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const prompt = locale === themeConfig.i18n.defaultLocale ? themeConfig.askAiTrigger || t('ai.prompt') : t('ai.prompt');
const llmsUrl = new URL('/llms.txt', themeConfig.site).href;
---

<section id="ask-ai" class="window ask-ai-window" aria-labelledby="ask-ai-title">
  <div class="window-titlebar">
    <span id="ask-ai-title" class="window-title"><span aria-hidden="true">✦</span> ask-ai.exe</span>
    <span class="window-controls" aria-hidden="true"><span>_</span><span>□</span><span>×</span></span>
  </div>
  <div class="window-content">
    <div class="ask-ai-intro">
      <div class="ask-ai-icon" aria-hidden="true">AI</div>
      <div>
        <h2>{t('ai.title')}</h2>
        <p>{t('ai.description')}</p>
      </div>
    </div>
    <label for="ask-ai-prompt">{t('ai.prompt-label')}</label>
    <textarea id="ask-ai-prompt" class="ask-ai-prompt" rows="5" readonly>{prompt}</textarea>
    <div class="button-row">
      <button class="win-button primary-action" type="button" data-copy-ai data-success={t('ai.copied')} data-error={t('ai.copy-error')}>{t('ai.copy')}</button>
      <a class="win-button" href={llmsUrl}>{t('ai.view-context')}</a>
    </div>
    <p class="ask-ai-status" data-copy-status role="status" aria-live="polite"></p>
  </div>
  <div class="status-bar"><span>{t('ai.provider-note')}</span><span>llms.txt</span></div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-ai]');
  const prompt = document.querySelector<HTMLTextAreaElement>('#ask-ai-prompt');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  button?.addEventListener('click', async () => {
    if (!prompt || !status) return;
    try {
      if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
      await navigator.clipboard.writeText(prompt.value);
      status.textContent = button.dataset.success || '';
    } catch {
      prompt.focus();
      prompt.select();
      status.textContent = button.dataset.error || '';
    }
  });
</script>
